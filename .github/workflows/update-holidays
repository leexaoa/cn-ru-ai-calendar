name: Update Holidays Calendar

on:
  schedule:
    # 每个月的第一天 00:00 UTC 运行
    - cron: '0 0 1 * *'
  # 也支持手动触发
  workflow_dispatch:

jobs:
  update-calendar:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Generate calendar
        run: |
          python generate.py

      - name: Check if calendar changed
        id: calendar_changed
        run: |
          if git diff --quiet calendar.ics; then
            echo "changed=false" >> $GITHUB_OUTPUT
          else
            echo "changed=true" >> $GITHUB_OUTPUT
          fi

      - name: Commit and push changes
        if: steps.calendar_changed.outputs.changed == 'true'
        run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add calendar.ics
          git commit -m "chore: auto update holidays calendar $(date -u +'%Y-%m-%d')"
          git push

      - name: Create Pull Request
        if: steps.calendar_changed.outputs.changed == 'true'
        uses: peter-evans/create-pull-request@v5
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          commit-message: "Auto update holidays calendar"
          title: "🗓️ Auto: Update holidays calendar"
          body: "Automatically updated holidays calendar for current period"
          branch: auto/update-calendar
